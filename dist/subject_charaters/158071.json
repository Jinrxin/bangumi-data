r/400/pic/crt/l/75/c5/95504_prsn_rZrR3.jpg?r=1782694157"},"name":"桜町弘子","short_summary":"日本の女優。本名は臼井 真琴。静岡県賀茂郡出身。静岡県立下田南高等学校卒業。","career":["actor"],"id":95504,"type":1,"locked":false}],"type":1,"id":215781},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/48/0b/215782_crt_BlLz9.jpg","grid":"https://lain.bgm.tv/pic/crt/g/48/0b/215782_crt_BlLz9.jpg","large":"https://lain.bgm.tv/pic/crt/l/48/0b/215782_crt_BlLz9.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/48/0b/215782_crt_BlLz9.jpg"},"name":"おけいちゃん","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/2b/ab/95506_prsn_XBM5Z.jpg","grid":"https://lain.bgm.tv/pic/crt/g/2b/ab/95506_prsn_XBM5Z.jpg","large":"https://lain.bgm.tv/pic/crt/l/2b/ab/95506_prsn_XBM5Z.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/2b/ab/95506_prsn_XBM5Z.jpg"},"name":"松島トモ子","short_summary":"日本の女優、歌手、タレント。現在、毒蝮三太夫が所属する、まむしプロダクションと業務提携をしている。\r\n\r\n満洲国奉天（現・瀋陽市）生まれ。東京都目黒区育ち。目黒区立東根小学校を経てザ・マスターズ・ハイスクール（英語版）卒業。現在も東京都在住。","career":["artist","actor"],"id":95506,"type":1,"locked":false}],"type":1,"id":215782},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/10/c8/215783_crt_PUZj6.jpg","grid":"https://lain.bgm.tv/pic/crt/g/10/c8/215783_crt_PUZj6.jpg","large":"https://lain.bgm.tv/pic/crt/l/10/c8/215783_crt_PUZj6.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/10/c8/215783_crt_PUZj6.jpg"},"name":"夜叉姫おもん","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/78/8e/95507_prsn_zCqwS.jpg","grid":"https://lain.bgm.tv/pic/crt/g/78/8e/95507_prsn_zCqwS.jpg","large":"https://lain.bgm.tv/pic/crt/l/78/8e/95507_prsn_zCqwS.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/78/8e/95507_prsn_zCqwS.jpg"},"name":"杉山とく子","short_summary":"日本の女優。東京府（現東京都）出身。代表作は映画『キューポラのある街』、テレビドラマ『男はつらいよ』、『渡る世間は鬼ばかりシリーズ』。","career":["actor"],"id":95507,"type":1,"locked":false}],"type":1,"id":215783},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/69/c4/215784_crt_wu1QG.jpg","grid":"https://lain.bgm.tv/pic/crt/g/69/c4/215784_crt_wu1QG.jpg","large":"https://lain.bgm.tv/pic/crt/l/69/c4/215784_crt_wu1QG.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/69/c4/215784_crt_wu1QG.jpg"},"name":"ばったの三次","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/61/55/95508_prsn_77tuj.jpg","grid":"https://lain.bgm.tv/pic/crt/g/61/55/95508_prsn_77tuj.jpg","large":"https://lain.bgm.tv/pic/crt/l/61/55/95508_prsn_77tuj.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/61/55/95508_prsn_77tuj.jpg"},"name":"堺駿二","short_summary":"東京都出身のコメディアン、喜劇俳優である。本名は栗原 正至。\r\n\r\n実兄は浪曲師の港家小柳丸（初代）、次男はマルチタレントの堺正章。甥にボンボンブラザースの鏡味繁二郎（本名：栗原重夫）がいる。","career":["actor"],"id":95508,"type":1,"locked":false}],"type":1,"id":215784},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/d7/c4/215785_crt_HobRo.jpg","grid":"https://lain.bgm.tv/pic/crt/g/d7/c4/215785_crt_HobRo.jpg","large":"https://lain.bgm.tv/pic/crt/l/d7/c4/215785_crt_HobRo.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/d7/c4/215785_crt_HobRo.jpg"},"name":"白雲斎","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/1f/f7/95509_prsn_82vA8.jpg?r=1782695022","grid":"https://lain.bgm.tv/pic/crt/g/1f/f7/95509_prsn_82vA8.jpg?r=1782695022","large":"https://lain.bgm.tv/pic/crt/l/1f/f7/95509_prsn_82vA8.jpg?r=1782695022","medium":"https://lain.bgm.tv/r/400/pic/crt/l/1f/f7/95509_prsn_82vA8.jpg?r=1782695022"},"name":"薄田研二","short_summary":"日本の俳優。本名：高山 徳右衛門（幼名：徳太郎）。\r\n\r\n築地小劇場研究生からキャリアをスタートさせ、同劇場分裂後に新築地劇団の結成に参加、同劇団の中核的存在として活躍。その後も苦楽座、劇団中芸、東京芸術座などの劇団を設立し、新劇運動の中心的指導者となった。晩年は後進の教育にもあたっている。戦中・戦後は映画にも多く出演しており、特に東映時代劇で欠かせない悪役俳優として知られた。著書に自伝『暗転　わが演劇自伝』（東峰書院、1960年）など。前妻は高山晴子（倉田百三の最初の妻）、後妻は女優の内田礼子。息子は高山象三、娘は女優の薄田つま子。","career":["actor"],"id":95509,"type":1,"locked":false}],"type":1,"id":215785},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/34/9a/215786_crt_3mkT6.jpg","grid":"https://lain.bgm.tv/pic/crt/g/34/9a/215786_crt_3mkT6.jpg","large":"https://l