400/pic/crt/l/ca/8f/41550_prsn_tahHG.jpg?r=1765900231"},"name":"永瀬アンナ","short_summary":"日本の女性声優。東京都出身。81プロデュース所属\r\n\r\n[b]趣味・特技[/b]\r\n読書、演劇鑑賞、イラスト、漫画制作\r\nクラシックバレエ、ギター、トランペット、ピアノ、ダンス\r\n\r\n[b]受賞歴[/b]\r\n第17回声優アワード　新人声優賞","career":["seiyu"],"id":41550,"type":1,"locked":false}],"type":1,"id":202336},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/58/c7/210445_crt_BCykI.jpg","grid":"https://lain.bgm.tv/pic/crt/g/58/c7/210445_crt_BCykI.jpg","large":"https://lain.bgm.tv/pic/crt/l/58/c7/210445_crt_BCykI.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/58/c7/210445_crt_BCykI.jpg"},"name":"少女","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/76/55/67775_prsn_LCDY7.jpg","grid":"https://lain.bgm.tv/pic/crt/g/76/55/67775_prsn_LCDY7.jpg","large":"https://lain.bgm.tv/pic/crt/l/76/55/67775_prsn_LCDY7.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/76/55/67775_prsn_LCDY7.jpg"},"name":"咲川ひなの","short_summary":"出身地\r\n山形県\r\n芸歴\r\n2020年 Follow-Up養成所\r\n2022年 ステイラック\r\n特技\r\n新体操\r\n趣味\r\n柔軟、ピアノ、ヘアアレンジ\r\nSNS\r\nTwitter：@hinano_sak122","career":["seiyu"],"id":67775,"type":1,"locked":false}],"type":1,"id":210445},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/2f/7d/210449_crt_IuH6D.jpg","grid":"https://lain.bgm.tv/pic/crt/g/2f/7d/210449_crt_IuH6D.jpg","large":"https://lain.bgm.tv/pic/crt/l/2f/7d/210449_crt_IuH6D.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/2f/7d/210449_crt_IuH6D.jpg"},"name":"店員","summary":"","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/7b/89/31638_prsn_iA5P8.jpg?r=1736171834","grid":"https://lain.bgm.tv/pic/crt/g/7b/89/31638_prsn_iA5P8.jpg?r=1736171834","large":"https://lain.bgm.tv/pic/crt/l/7b/89/31638_prsn_iA5P8.jpg?r=1736171834","medium":"https://lain.bgm.tv/r/400/pic/crt/l/7b/89/31638_prsn_iA5P8.jpg?r=1736171834"},"name":"岡純子","short_summary":"出身地：東京都\r\n特技：書道\r\n趣味：散歩、魚を見ること、ドラえもんを見ること","career":["seiyu"],"id":31638,"type":1,"locked":false}],"type":1,"id":210449},{"images":{"small":"","grid":"","large":"","medium":""},"name":"オタク","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/72/98/4513_prsn_o6DbE.jpg","grid":"https://lain.bgm.tv/pic/crt/g/72/98/4513_prsn_o6DbE.jpg","large":"https://lain.bgm.tv/pic/crt/l/72/98/4513_prsn_o6DbE.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/72/98/4513_prsn_o6DbE.jpg"},"name":"杉田智和","short_summary":"在其代表作品中常出演擅长吐槽的男主角（特别是凉宫春日中的阿虚），号称“第一吐槽男”。\r\n专长是按摩、少林寺拳法初段。爱犬的名字为Naoji。\r\n著名的“超级机器人大战FAN”，其称为“老师”的绿川光是著名的“超级玩家”，并且同为系列死忠。\r\n在声优界亲近的友人有中村悠一、铃村健一、樱井孝宏、小野大辅、神谷浩史等人。\r\n经常对外宣称与中村悠一的亲密关系（广播节目、声优见面会以及自己的生日庆祝EVENT等），还说过“只要有中村和直司（Naoji，杉田家的狗）就够了，我是杉田智和。”两人关系好得经常被其他声优说“像在交往一样”。\r\n另外与同为声优的铃木达央、羽多野涉、寺岛拓笃、市来光弘等人关系友好，合称为“杉田组”，杉田智和是杉田组的组长。\r\n崇拜的业内人士有若本规夫（杉田喜欢模仿这位是出了名的）、速水奖（中学时代就常听他的radio节目） 、铃置洋孝、绿川光（机器人大战同好）、置鲇龙太郎。\r\nLOVEPLUS的重度中毒者之一，跟阪口大助同为攻略游戏中的高岭爱花，并有在杉田的广播节目互相交流“女友经”。\r\n学园传奇冒险游戏月英学园 -kou-的原作者，其饰演执事一角。\r\n与中村悠一多次使用过淫梦梗，被鉴定为淫梦民。\r\n\r\n2009年获得声优奖男优部门配角赏","career":["seiyu"],"id":4513,"type":1,"locked":false}],"type":1,"id":215682},{"images":{"small":"","grid":"","large":"","medium":""},"name":"かちえの彼氏","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/ad/f7/3967_prsn_XC09F.jpg","grid":"https://lain.bgm.tv/pic/crt/g/ad/f7/3967_prsn_XC09F.jpg","large":"https://lain.bgm.tv/pic/crt/l/ad/f7/3967_prsn_XC09F.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/ad/f7/3967_prsn_XC09F.jpg"},"name":"緑川光","short_summary":"绿川光是日本声优界青年声优中的佼佼者之一，以其纯净纤细的独特声线为观众所喜爱。他偏冷色的音质十分适合饰演一些感性的角色，如《不思议游戏》中的鬼宿和《精灵使》中的觉罗。有时也会出演一些冷酷的恶役角色。其出演的角色中，有不少是看似性格孤僻、很难接近的人物，他声音中的“冷感”在这一类型的角色身上得到了充分的发挥。如《新机动战记高达W》中的希罗·尤尔和《灌篮高手》中的流川枫，但是细细品来可以发觉这些人物大都是本质纯朴、性格率直的少年。不甘被定型的绿川光还为拓展戏路而饰演了《白色猎人》中邪恶阴险的基路德比、《魔剑美神》（又名：秀逗魔导士）中笑料百出的杰路·刚帝士等与之前角色迥然不同的人物，其表现也十分出色 。最近还在乙女向游戏《Starry☆Sky～in Spring～》中担当人气的土萌羊配音。","career":["artist","seiyu"],"id":3967,"type":1,"locked":false}],"type":1,"id":215683},{"images":{"small":"","grid":"","large":"","medium":""},"name":"やばい女","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/df/db/5009_prsn_JH7Vv.jpg?r=1576158226","grid":"https://lain.bgm.tv/pic/crt/g/df/db/5009_prsn_JH7Vv.jpg?r=1576158226","large":"https://lain.bgm.tv/pic/crt/l/df/db/5009_prsn_JH7Vv.jpg?r=1576158226","medium":"https://lain.bgm.tv/r/400/pic/crt/l/df/db/5009_prsn_JH7Vv.jpg?r=1576158226"},"name":"くじら","short_summary":"くじら（1961年4月1日 - ）は、日本の声優、女優。81プロデュース所属。東京都出身。本名および、旧芸名は松本 和香子（まつもと わかこ）。\r\n\r\n本人曰く、この芸名は千葉繁が命名したとのこと。彼が主宰する劇団バーストマンに参加していた時期があり、共演の多い立木文彦も同劇団に所属している。\r\n2011年10月25日、Twitterで結婚したことを発表した。","career":["seiyu","actor"],"id":5009,"type":1,"locked":false}],"type":1,"id":215684},{"images":{"small":"","grid":"","large":"","medium":""},"name":"あめちゃん祖母","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/f9/05/5159_prsn_tt0ZA.jpg?r=1748186756","grid":"https://lain.bgm.tv/pic/crt/g/f9/05/5159_prsn_tt0ZA.jpg?r=1748186756","large":"https://lain.bgm.tv/pic/crt/l/f9/05/5159_prsn_tt0ZA.jpg?r=1748186756","medium":"https://lain.bgm.tv/r/400/pic/crt/l/f9/05/5159_prsn_tt0ZA.jpg?r=1748186756"},"name":"定岡小百合","short_summary":"日本の女性声優。神奈川県出身。プロダクション・エース所属。","career":["seiyu"],"id":5159,"type":1,"locked":false}],"type":1,"id":215685},{"images":{"small":"","grid":"","large":"","medium":""},"name":"あめちゃん母","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/a4/ec/3993_prsn_jh8Zr.jpg?r=1420267752","grid":"https://lain.bgm.tv/pic/crt/g/a4/ec/3993_prsn_jh8Zr.jpg?r=1420267752","large":"https://lain.bgm.tv/pic/crt/l/a4/ec/3993_prsn_jh8Zr.jpg?r=1420267752","medium":"https://lain.bgm.tv/r/400/pic/crt/l/a4/ec/3993_prsn_jh8Zr.jpg?r=1420267752"},"name":"桃井はるこ","short_summary":"来历\r\n\r\n高中时因开始电脑通信为契机而进入杂志社从事作家活动。据说在网络开始普及的时候已经拥有个人的网页。\r\n大学时开始在原宿与秋叶原的路旁展开街头演唱活动，而受到瞩目。\r\n在2000年的正式出道单曲‘Mail Me’发行后，开始专业音乐活动。另外在2001年的电视动画《The Soul Taker～魂狩～》达成声优出道。\r\n2002年和小池雅也组成‘UNDER17’，积极从事演唱活动，但是在2004年时解散。其后以单人重新展开音乐活动，2005年的第1场单人巡回演唱会‘ワンダーモモーイツアー’在大阪、名古屋、博多、涩谷举行，2006年成立了歌迷期待已久的“桃井晴子后援会‘m.m.m’”。\r\n2007年发售了超自传DVD戏剧‘はるこ☆UP DATE’以及首次的著书‘アキハバLOVE’，持续各方面的活动。\r\n\r\n人物\r\n“はるこ”据说是来自电影《2001太空漫游》中登场的电脑“HAL 9000”。因此罗马字表记是使用“Halko”而非“Haruko”。\r\n本名为“晴子”（在‘ウラモモーイ’内的发言）。另外“桃井”这个艺名是来自曾居住过的东京都杉并区桃井。\r\n有着非常特殊的大舌头声音，借由巧妙的运用她的声音，经常演出天然系的女孩子。自己的歌也有特征，萌歌歌手其中之一。\r\n掲示板‘あやしいわーるど’的分支‘あやしいわーるど＠クリスマス岛’の古参投稿者でもある。\r\n和同年的声优浅野真澄与野川樱关系良好，也有在她们的专辑里提供歌曲。\r\n自小为“东京养乐多燕子”的球迷，不过在野村教练上任后加入了“东北乐天金鹰队”的后援会。\r\n中学时代是位女性（一般）偶像迷。\r\n和千叶纱子属于同期，但彼此间没有面识（虽然桃井知道千叶的事，想要更加认识，但可惜没有机会）。另外也担任过学生会副会长，在文化祭的指引手册里刊载有藤崎诗织（“心跳回忆”游戏角色）的Cosplay照片。而在高中的学生证上则是放了绫波零的Cosplay照片。\r\n从小学起就不断往返秋叶原。公开声明自己是御宅族，在广播节目里也喜欢谈论浓厚的话题。当2008年6月8日秋叶原发生杀人事件，桃井亲自到案发地方献花吊祭死者，情绪激动。","career":["artist","seiyu"],"id":3993,"type":1,"locked":false}],"type":1,"id":215686},{"images":{"small":"","grid":"","large":"","medium":""},"name":"あめちゃん父","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/83/45/4424_seiyu_anidb.jpg","grid":"https://lain.bgm.tv/pic/crt/g/83/45/4424_seiyu_anidb.jpg","large":"https://lain.bgm.tv/pic/crt/l/83/45/4424_seiyu_anidb.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/83/45/4424_seiyu_anidb.jpg"},"name":"中井和哉","short_summary":"日本の男性声優、ナレーター。兵庫県神戸市出身。青二プロダクション所属。","career":["seiyu"],"id":4424,"type":1,"locked":false}],"type":1,"id":215687},{"images":{"small":"","grid":"","large":"","medium":""},"name":"オタク","summary":"","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/af/c4/9953_prsn_O0Dsl.jpg","grid":"https://lain.bgm.tv/pic/crt/g/af/c4/9953_prsn_O0Dsl.jpg","large":"https://lain.bgm.tv/pic/crt/l/af/c4/9953_prsn_O0Dsl.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/af/c4/9953_prsn_O0Dsl.jpg"},"name":"石川界人","short_summary":"日本男性声优。隶属于Stay Luck，出生于东京都。\r\n\r\n趣味\t読書、一人劇\r\n特技\t水泳、ウィンタースポーツ\r\n経歴\tプロ・フィット声優養成所　卒\r\n2014年第八回声優アワードにて「新人男優賞」受賞。\r\n2020年第十四回声優アワードにて「助演男優賞」受賞。\r\n2022年2月1日、ステイラックへ移籍。\r\n\r\n2025年9月30日，宣布与内田真礼结婚。","career":["seiyu"],"id":9953,"type":1,