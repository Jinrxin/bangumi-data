/crt/l/49/4f/55419_crt_M7hc4.jpg?r=1738603206","medium":"https://lain.bgm.tv/r/400/pic/crt/l/49/4f/55419_crt_M7hc4.jpg?r=1738603206"},"summary":"オーストリアの女帝マリア・テレジアの娘。14歳でルイ16世の妃になるため、フランスにやってきた。\r\n\r\n美しく誇り高く、人を惹き付ける天性の魅力を持つが、フランス宮廷の窮屈さや、周囲の重圧から逃れようと奔放で贅沢な生活を送る。","name":"マリー・アントワネット","infobox":[{"key":"简体中文名","value":"玛丽·安托瓦内特"},{"key":"别名","value":[{"k":"英文名","v":"Marie Antoinette"}]},{"key":"性别","value":"女"}],"stat":{"comments":3,"collects":9},"id":55419,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":"male","birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/7f/b5/170575_crt_FGKGz.jpg?r=1738603500","grid":"https://lain.bgm.tv/pic/crt/g/7f/b5/170575_crt_FGKGz.jpg?r=1738603500","large":"https://lain.bgm.tv/pic/crt/l/7f/b5/170575_crt_FGKGz.jpg?r=1738603500","medium":"https://lain.bgm.tv/r/400/pic/crt/l/7f/b5/170575_crt_FGKGz.jpg?r=1738603500"},"summary":"下級貴族出身で元は士官学校を出た少尉だったが、とある事情で上官を殴ったためフランス衛兵隊に降格した。\r\n\r\n衛兵隊の仲間から慕われており、剣の腕前は、オスカルも一目置くほどの実力。","name":"アラン・ド・ソワソン","infobox":[{"key":"简体中文名","value":"亚兰·德·索瓦逊"},{"key":"别名","value":[]},{"key":"性别","value":"男"}],"stat":{"comments":2,"collects":0},"id":170575,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":null,"birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/01/01/10956_crt_5LR7z.jpg","grid":"https://lain.bgm.tv/pic/crt/g/01/01/10956_crt_5LR7z.jpg","large":"https://lain.bgm.tv/pic/crt/l/01/01/10956_crt_5LR7z.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/01/01/10956_crt_5LR7z.jpg"},"summary":"戏剧角色背着台上其他剧中人对观众说的话。也指影视片中的解说词。说话者不出现在画面上，但直接以语言来介绍影片内容、交待剧情或发表议论，包括对白的使用。","name":"ナレーション","infobox":[{"key":"简体中文名","value":"旁白"},{"key":"别名","value":[{"v":"ナレーター"},{"k":"第二中文名","v":"解説"},{"k":"英文名","v":"Narration / Narrator"},{"k":"日文名","v":"語り"},{"k":"罗马字","v":"Nareeshon"},{"k":"昵称","v":"天之声"},{"k":"拼音","v":"páng bái"}]}],"stat":{"comments":72,"collects":215},"id":10956,"lo