n.bgm.tv/r/100/pic/crt/l/7d/e6/63522_prsn_1f2ov.jpg","grid":"https://lain.bgm.tv/pic/crt/g/7d/e6/63522_prsn_1f2ov.jpg","large":"https://lain.bgm.tv/pic/crt/l/7d/e6/63522_prsn_1f2ov.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/7d/e6/63522_prsn_1f2ov.jpg"},"name":"丸中康司","short_summary":"出身地：鳥取県\r\n特技・趣味：鳥取弁 / 麻雀 / 将棋 / バク転 / 韓流ドラマ / 体操 / バレーボール / ONE PIECE\r\n\r\n学生時代は生徒会長を務め、部活は体操競技に励み、学業では英語が得意で、関西学院大学の英米学専修に進学し、英語を専門的に学ぶ。\r\n地元の鳥取で英語の教師をすることが決まっていたが、それを蹴って上京し、ドリーマーに。\r\n整理整頓と掃除が好きで、潔癖に近いほどのきれい好き。\r\n生き物が大好きで、特に、爬虫類、両生類、昆虫に沼る。\r\n最近のマイブームはオオサンショウウオ。\r\nいつの日か、明石家さんまさんに会うのが夢。","career":["seiyu"],"id":63522,"type":1,"locked":false}],"type":1,"id":228234},{"images":{"small":"","grid":"","large":"","medium":""},"name":"沖直人","summary":"","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/04/a8/30665_prsn_ON9Z2.jpg","grid":"https://lain.bgm.tv/pic/crt/g/04/a8/30665_prsn_ON9Z2.jpg","large":"https://lain.bgm.tv/pic/crt/l/04/a8/30665_prsn_ON9Z2.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/04/a8/30665_prsn_ON9Z2.jpg"},"name":"荒木寿茂","short_summary":"","career":["seiyu"],"id":30665,"type":1,"locked":false}],"type":1,"id":228235},{"images":{"small":"","grid":"","large":"","medium":""},"name":"川口秀夫","summary":"","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/41/b2/21093_prsn_AHm3K.jpg?r=1459951274","grid":"https://lain.bgm.tv/pic/crt/g/41/b2/21093_prsn_AHm3K.jpg?r=1459951274","large":"https://lain.bgm.tv/pic/crt/l/41/b2/21093_prsn_AHm3K.jpg?r=1459951274","medium":"https://lain.bgm.tv/r/400/pic/crt/l/41/b2/21093_prsn_AHm3K.jpg?r=1459951274"},"name":"陣谷遥","short_summary":"陣谷 遥（じんや はるか、10月23日 - ）は、日本の男性声優。\r\n\r\n誕生日：10月23日\r\n出身地：千葉県\r\n趣味・特技：サッカー観戦・ゲーム","career":["seiyu"],"id":21093,"type":1,"locked":false}],"type":1,"id":228236},{"images":{"small":"","grid":"","large":"","medium":""},"name":"伊藤悟","summary":"","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/11/30/43608_pr