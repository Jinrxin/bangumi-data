":"https://lain.bgm.tv/r/100/pic/crt/l/d8/6c/177538_crt_5NN52.jpg?r=1749470350","grid":"https://lain.bgm.tv/pic/crt/g/d8/6c/177538_crt_5NN52.jpg?r=1749470350","large":"https://lain.bgm.tv/pic/crt/l/d8/6c/177538_crt_5NN52.jpg?r=1749470350","medium":"https://lain.bgm.tv/r/400/pic/crt/l/d8/6c/177538_crt_5NN52.jpg?r=1749470350"},"name":"狭山ヶ丘ちよ","relation":"主角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/7c/bc/41446_prsn_Mg2LJ.jpg?r=1617686564","grid":"https://lain.bgm.tv/pic/crt/g/7c/bc/41446_prsn_Mg2LJ.jpg?r=1617686564","large":"https://lain.bgm.tv/pic/crt/l/7c/bc/41446_prsn_Mg2LJ.jpg?r=1617686564","medium":"https://lain.bgm.tv/r/400/pic/crt/l/7c/bc/41446_prsn_Mg2LJ.jpg?r=1617686564"},"name":"村上まなつ","short_summary":"日本ナレーション演技研究所出身。2018年10月1日、同養成所の関連会社であるアライズプロジェクトへの所属が発表された。\r\n\r\n2019年より声優ユニット「DIALOGUE+」にメンバーとして参加する。\r\n\r\n特技には縦開脚と手の筋はずし、趣味にはダンスとクレープ作成動画の視聴をそれぞれ挙げている。\r\n\r\n声優になろうと思ったきっかけは『HUNTER×HUNTER（第2作）』と『ココロコネクト』で沢城みゆきがそれぞれ異なるキャラを同時期に演じていることに感動したことから。","career":["seiyu"],"id":41446,"type":1,"locked":false}],"type":1,"id":177538},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/4b/4a/177539_crt_tP09F.jpg?r=1749470364","grid":"https://lain.bgm.tv/pic/crt/g/4b/4a/177539_crt_tP09F.jpg?r=1749470364","large":"https://lain.bgm.tv/pic/crt/l/4b/4a/177539_crt_tP09F.jpg?r=1749470364","medium":"https://lain.bgm.tv/r/400/pic/crt/l/4b/4a/177539_crt_tP09F.jpg?r=1749470364"},"name":"本郷みゆき","relation":"主角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/d9/c4/14781_prsn_gI799.jpg","grid":"https://lain.bgm.tv/pic/crt/g/d9/c4/14781_prsn_gI799.jpg","large":"https://lain.bgm.tv/pic/crt/l/d9/c4/14781_prsn_gI799.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/d9/c4/14781_prsn_gI799.jpg"},"name":"青木瑠璃子","short_summary":"青木瑠璃子（1990年3月24日－）是日本的女性声优，Atomic Monkey所属。埼玉县出身。血型O型。法政大学社会学部媒体社会学科毕业。\r\n\r\n趣味・特技：剣道、水泳、ゲーム","career":["seiyu"],"id":14781,"type":1,"locked":false}],"type":1,"id":177539},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/85/b7/186180_crt_etUZU.jpg","grid":"https://lain.bgm.tv/pic/crt/g/85/b7/186180_crt_etUZU.jpg","large":"https://lain.bgm.tv/pic/crt/l/85/b7/186180_crt_etUZU.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/85/b7/186180_crt_etUZU.jpg"},"name":"理事長","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/2b/f2/3986_prsn_ZAA2q.jpg?r=1469971214","grid":"https://lain.bgm.tv/pic/crt/g/2b/f2/3986_prsn_ZAA2q.jpg?r=1469971214","large":"https://lain.bgm.tv/pic/crt/l/2b/f2/3986_prsn_ZAA2q.jpg?r=1469971214","medium":"https://lain.bgm.tv/r/400/pic/crt/l/2b/f2/3986_prsn_ZAA2q.jpg?r=1469971214"},"name":"高木渉","short_summary":"出身于千叶县的日本男性声优、舞台演员。所属事务所是ARTSVISION。\r\n\r\n胜田声优学院第5期毕业。1987年以《妙手小厨师》声优出道。\r\n担任剧团“あかぺら倶楽部”的代表，亦常以舞台演员的身份活动。2002年和山口胜平、关智一合组名为“三人帮（さんにんのかい）”的三人戏剧团体。\r\n2005年接任《哆啦A梦》的老师角色、2007年接《鬼太郎》的鼠男，在重制动画当中继承大梁位置。\r\n\r\n在动画、外语配音等多方面活跃，主要演出少年、青年、上至中年、老人角色，其他像小坏蛋、丑角、坏小孩、傲慢男、俊俏帅哥、动物、甚至肆无忌惮口出秽言的残酷恶徒或滑稽角色等都经历过。\r\n有名的迟到大王。在配《鲁莽天使》的时候，曾经因为迟到让许多同僚等候，而被林原惠训斥。","career":["seiyu","actor"],"id":3986,"type":1,"locked":false}],"type":1,"id":186180},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/20/00/189075_crt_ELJAY.jpg","grid":"https://lain.bgm.tv/pic/crt/g/20/00/189075_crt_ELJAY.jpg","large":"https://lain.bgm.tv/pic/crt/l/20/00/189075_crt_ELJAY.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/20/00/189075_crt_ELJAY.jpg"},"name":"阪本コーチ","relation":"","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/7f/7c/30620_prsn_037Bn.jpg?r=1723962282","grid":"https://lain.bgm.tv/pic/crt/g/7f/7c/30620_prsn_037Bn.jpg?r=1723962282","large":"https://lain.bgm.tv/pic/crt/l/7f/7c/30620_prsn_037Bn.jpg?r=1723962282","medium":"https://lain.bgm.tv/r/400/pic/crt/l/7f/7c/30620_prsn_037Bn.jpg?r=1723962282"},"name":"鈴木崚汰","short_summary":"日本の男性声優。愛知県出身。日本ナレーション演技研究所出身。ヴィムス所属。","career":["seiyu"],"id":30620,"type":1,"locked":false}],"type":1,"id":189075},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/99/fb/189529_crt_ga107.jpg","grid"