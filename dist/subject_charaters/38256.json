/lain.bgm.tv/pic/crt/g/f8/0b/42363_crt_bwlg8.jpg","large":"https://lain.bgm.tv/pic/crt/l/f8/0b/42363_crt_bwlg8.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/f8/0b/42363_crt_bwlg8.jpg"},"summary":"YF-19の主任設計者。そばかすが目立つ冴えない少年だが、17歳の若さで次期主力戦闘機の設計主任になった天才。機械への偏った愛情が、乗り手を選ぶYF-19の機体特性に反映されている。プライベートでもシャロンを愛する凄腕のハッカー。","name":"ヤン・ノイマン","infobox":[{"key":"简体中文名","value":"杨·诺曼"},{"key":"别名","value":[{"k":"英文名","v":"Yang Neumann"}]},{"key":"性别","value":"男"}],"stat":{"comments":1,"collects":2},"id":42363,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":"female","birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/ed/72/11941_crt_58KyL.jpg","grid":"https://lain.bgm.tv/pic/crt/g/ed/72/11941_crt_58KyL.jpg","large":"https://lain.bgm.tv/pic/crt/l/ed/72/11941_crt_58KyL.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/ed/72/11941_crt_58KyL.jpg"},"summary":"本作のヒロイン。イサムとガルドの幼馴染み。23歳の中国系白人[1]。幼少より歌を愛し、歌手になることを志していた。ハイスクールのマドンナ的存在だったが、ある事件をきっかけに地球に渡り、一度は歌を捨てる。7年後にシャロン・アップル・プロジェクトのプロデューサーとしてエデンに戻り、イサムとガルドとの恋の板挟みで苦悩する。持ち歌「VOICES」はハイスクール時代に作ったもの。","name":"ミュン・ファン・ローン","infobox":[{"key":"简体中文名","value":"谬芳容"},{"key":"别名","value":[{"k":"罗马字","v":"Myung Fang Lone"}]},{"key":"性别","value":"女"},{"key":"引用来源","value":"http://ja.wikipedia.org"}],"stat":{"comments":5,"collects":18},"id":11941,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":"female","birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/37/bb/42361_crt_ZHyRc.jpg","grid":"https://lain.bgm.tv/pic/crt/g/37/bb/42361_crt_ZHyRc.jpg","large":"https://lain.bgm.tv/pic/crt/l/37/bb/42361_crt_ZHyRc.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/37/bb/42361_crt_ZHyRc.jpg"},"summary":"人工知能によって2039年に生まれ、2040年には銀河系最大の人気となったバーチャルアイドル。ファンの声援に呼応して、その容姿、歌声は幾重にも変化する。","name":"シャロン・アップル","infobox":[{"key":"简体中文名","value":"莎朗·埃普"},{"key":"别名","value":[{"k":"英文名","v":"Sharon Apple"}]},{"key":"性别","value":"女"}],"stat":{"comments":4,"collects":9},"id":42361,"locked":false,"type":1,"nsfw":false},{"birth_mon":3,"gender":"male","birth_day":27,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/f2/13/11940_crt_Cr6Cy.jpg","grid":"https://lain.bgm.tv/pic/crt/g/f2/13/11940_crt_Cr6Cy.jpg","large":"https://lain.bgm.tv/pic/crt/l/f2/13/11940_crt_Cr6Cy.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/f2/13/11940_crt_Cr6Cy.jpg"},"summary":"主人公。フルネームはイサム・アルヴァ・ダイソン。階級は中尉。2015年3月27日生まれの24歳。テストパイロットとして新星インダストリー社の新型可変戦闘機YF-19を担当する。ガルドとミュンとは旧知の仲。幼少より大空を飛ぶことに魅せられ、ダルメシアンハイスクール時代のある事件をきっかけに惑星エデンを離れ、統合軍にパイロットとして入隊。腕前は超一流であり、エースパイロットの証「ロイ・フォッカー勲章」を3度受章しているが、自由奔放な性格で軍規違反を繰り返し、前述勲章を3度とも剥奪されるほどの問題児でもある。統合軍内をたらい回しにされ、辺境でゼントラーディ残存兵と戦っていたが、前任者を何人も病院送りにした「じゃじゃ馬」YF-19のテストパイロットとしてエデンへと戻ってきた。","name":"イサム・ダイソン","infobox":[{"key":"简体中文名","value":"勇·戴森"},{"key":"别名","value":[{"k":"日文名","v":"イサム・ダイソン"},{"k":"罗马字","v":"Isamu Alva Dyson"}]},{"key":"性别","value":"男"},{"key":"生日","value":"3月27日"},{"key":"引用来源","value":"http://ja.wikipedia.org"}],"stat":{"comments":5,"collects":8},"id":11940,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":"male","birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/9c/81/42360_crt_X7gc1.jpg","grid":"https://lain.bgm.tv/pic/crt/g/9c/81/42360_crt_X7gc1.jpg","large":"https://lain.bgm.tv/pic/crt/l/9c/81/42360_crt_X7gc1.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/9c/81/42360_crt_X7gc1.jpg"},"summary":"ゼネラル・ギャラクシー社の開発主任兼テストパイロット。25歳。新型可変戦闘機YF-21を担当する。沈着冷静だが、イサムとは意地を張りあうライバル同士。ゼントラーディと地球人の共存により生まれた混血児（いわゆるピースチルドレン）で、遺伝により明晰な頭脳と屈強な肉体を具えている。しかし、成長と共に巨人族の血の発作的な攻撃衝動に襲われ、密かに抑用薬を服用していたが、これが後々テスト中に重大な事件を引き起こす。\r\n\r\nOVA版と映画版では、その結末が若干変更されている。","name":"ガルド・ゴア・ボーマン","infobox":[{"key":"简体中文名","value":"加鲁特·加奥·保曼"},{"key":"别名","value":[{"k":"第二中文名","v":"卡尔德·哥文·波文"},{"k":"英文名","v":"Guld Goa Bowman"}]},{"key":"性别","value":"男"}],"stat":{"comments":4,"collects":4},"id":42360,"locked":f