/pic/crt/l/dd/a0/122334_crt_Y4KKF.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/dd/a0/122334_crt_Y4KKF.jpg"},"summary":"A型のエンジン推力を向上させた改良型。『マクロスプラス』に登場。この型にてメーカーの量産体制が整い、主力機として大量に生産、配備されている。","name":"VF-11B サンダーボルト","infobox":[{"key":"别名","value":[{"k":"英文名","v":"VF-11B Thunderbolt"}]},{"key":"引用来源","value":"http://www.macross2.net/m3/macrossplus/vf-11b.htm"}],"stat":{"comments":0,"collects":0},"id":122334,"locked":false,"type":2,"nsfw":false},{"birth_mon":null,"gender":"male","birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/e4/36/42365_crt_1248Y.jpg","grid":"https://lain.bgm.tv/pic/crt/g/e4/36/42365_crt_1248Y.jpg","large":"https://lain.bgm.tv/pic/crt/l/e4/36/42365_crt_1248Y.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/e4/36/42365_crt_1248Y.jpg"},"summary":"ミュンの補佐役で、シャロン・アップル・システムの開発者。23歳。人工知能に偏執的な愛情を注ぎ、統合軍と絡んで暗躍する。","name":"マージ・グルドア","infobox":[{"key":"简体中文名","value":"马季"},{"key":"别名","value":[{"k":"英文名","v":"Marj Gueldoa"}]},{"key":"性别","value":"男"}],"stat":{"comments":0,"collects":1},"id":42365,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":null,"birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/ae/06/122389_crt_5cZOK.jpg","grid":"https://lain.bgm.tv/pic/crt/g/ae/06/122389_crt_5cZOK.jpg","large":"https://lain.bgm.tv/pic/crt/l/ae/06/122389_crt_5cZOK.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/ae/06/122389_crt_5cZOK.jpg"},"summary":"","name":"ドローンファイター","infobox":[{"key":"别名","value":[{"k":"英文名","v":"Drone Fighter"}]},{"key":"引用来源","value":"http://www.macross2.net/m3/macrossplus/dronefighter.htm"}],"stat":{"comments":0,"collects":0},"id":122389,"locked":false,"type":2,"nsfw":false},{"birth_mon":null,"gender":null,"birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/4b/74/122387_crt_Au0SR.jpg","grid":"https://lain.bgm.tv/pic/crt/g/4b/74/122387_crt_Au0SR.jpg","large":"https://lain.bgm.tv/pic/crt/l/4b/74/122387_crt_Au0SR.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/4b/74/122387_crt_Au0SR.jpg"},"summary":"グァンダナモ級の上位艦として建造された2段甲板型空母。宇宙空間だけでなく大気圏内や水上でも航行可能。空母ながら巡洋艦に匹敵する攻撃力を備え、艦隊司令艦としても使用される。比較的新しい艦であるため、『マクロス7』の時代におけるマクロス7船団への配備数は少ない。全長約550m、全備重量約25,000t、搭載機数65 - 75機。フォールドエンジン搭載。","name":"ウラガ級護衛宇宙空母","infobox":[{"key":"别名","value":[{"k":"英文名","v":"Uraga-class Escort Battle Carriers"}]},{"key":"引用来源","value":"http://www.macross2.net/m3/macrossplus/uraga-escortbattlecarrier.htm"}],"stat":{"comments":0,"collects":0},"id":122387,"locked":false,"type":3,"nsfw":false},{"birth_mon":null,"gender":null,"birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/49/f3/120476_crt_rrdeR.jpg","grid":"https://lain.bgm.tv/pic/crt/g/49/f3/120476_crt_rrdeR.jpg","large":"https://lain.bgm.tv/pic/crt/l/49/f3/120476_crt_rrdeR.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/49/f3/120476_crt_rrdeR.jpg"},"summary":"超長距離砲撃型デストロイド。","name":"HWR-00-Mk.II モンスター","infobox":[{"key":"别名","value":[{"k":"英文名","v":"Monster"}]},{"key":"身高","value":"22.46m（砲先端まで）"},{"key":"体重","value":"285.5t（全備）"},{"key":"引用来源","value":"http://www.macross2.net/m3/sdfmacross/destroid-monster.htm"}],"stat":{"comments":0,"collects":0},"id":120476,"locked":false,"type":2,"nsfw":false},{"birth_mon":null,"gender":null,"birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/08/05/121843_crt_7F565.jpg","grid":"https://lain.bgm.tv/pic/crt/g/08/05/121843_crt_7F565.jpg","large":"https://lain.bgm.tv/pic/crt/l/08/05/121843_crt_7F565.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/08/05/121843_crt_7F565.jpg"},"summary":"もとは静止軌道上の浮きドックであったが、SDF-1マクロスを軸とする戦略構想の要請により、急遽宇宙支援空母へと改装されたものである。可変戦闘機バルキリーなど艦載機のプラットフォームとして機能する他、作戦中に燃料切れを起こした機体の回収行動も行う。そのため外装が強化され、艦尾には大型推進器が取り付けられた。 間に合わせ仕様ではあったものの、単純な構造による実用性と量産性には一定の評価がなされた。\r\n\r\n同級宇宙空母は月軌道上の工業ステーションで順次建造され、1,2番艦(ARMD-01,-02)がマクロスの両舷に接続される予定であった。しかし、西暦2009年のゼントラーディ軍との開戦時に、マクロスとのドッキングを阻止され、2隻とも撃沈された。その後8番艦まで(03~08)が就役し、オーベルト級宇宙駆逐艦とともに地球近傍の防衛任務にあたったが、これらもまたボドル基幹艦隊との決戦時に全滅した。","name":"ARMD-01 宇宙空母アームド","infobox":[{"key":"别名","value":[{"k":"英文名","v":"Armaments Rigged-up Moving Deck"}]},{"key":"引用来源","value":"https://macross.fandom.com/ja/wiki/宇宙空母アームド"}],"stat":{"comments":0,"collects":0},"id":121843,"locked":false,"type":3,"nsfw":false},{"birth_mon":null,"gender":"male","birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/cb/fe/42369_crt_uDivI.jpg","grid":"https://lain.bgm.tv/pic/crt/g/cb/fe/42369_crt_uDivI.jpg","large":"https://lain.bgm.tv/pic/crt/l/cb/fe/42369_crt_uDivI.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/cb/fe/42369_crt_uDivI.jpg"},"summary":"ケイトの夫。ジャーナリスト。イサムやガルド、ミュンの元同級生で、ハイスクール時代からイサムに対し熱狂的ともいえるシンパシーを抱いている。","name":"モーガン・マッソー","infobox":[{"key":"别名","value":[{"k":"英文名","v":"Morgan Masseau"}]},{"key":"性别","value":"男"}],"stat":{"comments":0,"collects":1},"id":42369,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":null,"birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/6b/80/122353_crt_2OkJm.jpg","grid":"https://lain.bgm.tv/pic/crt/g/6b/80/122353_crt_2OkJm.jpg","large":"https://lain.bgm.tv/pic/crt/l/6b/80/122353_crt_2OkJm.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/6b/80/122353_crt_2OkJm.jpg"},"summary":"OVA『マクロスプラス』に登場するVF-19の試作型。新統合軍の時期主力可変戦闘機選定トライアル「プロジェクト・スーパーノヴァ」参画のため、2034年に開発計画が始動し、2040年には惑星エデンのニューエドワーズ基地において、VF-22の試作機であるYF-21とのコンペティションを行う。呼号为α1（アルファワン）。設計主任はヤン・ノイマン、テストパイロットはイサム・ダイソン中尉。彼以前にも何人かのテストパイロットが搭乗していたが、飛行テスト中の事故によりその全てが死亡もしくは後送されている。なお劇中ではイサムが搭乗するYF-19は2号機という設定である。","name":"YF-19 アルファワン","infobox":[{"key":"别名","value":[{"k":"英文名","v":"YF-19 Alpha One"}]},{"key":"引用来源","value":"http://www.macross2.net/m3/macrossplus/yf-19.htm"}],"stat":{"comments":1,"collects":4},"id":122353,"locked":false,"type":2,"nsfw":false},{"birth_mon":null,"gender":nu