":"https://lain.bgm.tv/r/100/pic/crt/l/65/75/79488_prsn_numEo.jpg","grid":"https://lain.bgm.tv/pic/crt/g/65/75/79488_prsn_numEo.jpg","large":"https://lain.bgm.tv/pic/crt/l/65/75/79488_prsn_numEo.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/65/75/79488_prsn_numEo.jpg"},"name":"森風子","short_summary":"出身地：長崎県\r\n趣味：Vtuber鑑賞、フライドチキンを食べる\r\n　　　カメラ、電車旅\r\n特技：歌唱、接客\r\n方言：長崎弁","career":["seiyu"],"id":79488,"type":1,"locked":false}],"type":1,"id":216513},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/07/a1/216514_crt_DkZON.jpg","grid":"https://lain.bgm.tv/pic/crt/g/07/a1/216514_crt_DkZON.jpg","large":"https://lain.bgm.tv/pic/crt/l/07/a1/216514_crt_DkZON.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/07/a1/216514_crt_DkZON.jpg"},"name":"執事","summary":"","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/16/29/41759_prsn_EETVz.jpg","grid":"https://lain.bgm.tv/pic/crt/g/16/29/41759_prsn_EETVz.jpg","large":"https://lain.bgm.tv/pic/crt/l/16/29/41759_prsn_EETVz.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/16/29/41759_prsn_EETVz.jpg"},"name":"左座翔丸","short_summary":"日本の声優、舞台俳優。\r\n2016年にステイラック附属養成所・Follow-Upを経て、2018年4月よりステイラックに所属。","career":["seiyu","actor"],"id":41759,"type":1,"locked":false}],"type":1,"id":216514},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/7e/25/217132_crt_i5v7S.jpg","grid":"https://lain.bgm.tv/pic/crt/g/7e/25/217132_crt_i5v7S.jpg","large":"https://lain.bgm.tv/pic/crt/l/7e/25/217132_crt_i5v7S.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/7e/25/217132_crt_i5v7S.jpg"},"name":"高峰冬子","summary":"","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/da/21/3943_seiyu_anidb.jpg","grid":"https://lain.bgm.tv/pic/crt/g/da/21/3943_seiyu_anidb.jpg","large":"https://lain.bgm.tv/pic/crt/l/da/21/3943_seiyu_anidb.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/da/21/3943_seiyu_anidb.jpg"},"name":"園崎未恵","short_summary":"日本の声優、女優、ナレーター、歌手。リマックス所属。愛称は、みけ、おそのさん。\r\n\r\n東京都出身。身長155.5cm、血液型はA型。以前の芸名はそのざきみえ。\r\n\r\n在芭蕾舞教师母亲的教导下，小学入学时开始学习古典芭蕾舞剧。高中（女子学校）戏剧部所属。专科毕业后，俳协演剧研究所入所。老师是手冢敏夫。1994年3月同所毕业。毕业后从事舞台音响相关的工作，有电视剧临时演员和模特的经验。此后正式开始解说的工作。\r\n1996年，移籍至TAB Production。开始了声优的道路。\r\n1997年，以“そのざきみえ”为艺名作为声优出道。\r\n1999年1月，退出TAB Production。同年4月加入Remax。\r\n2002年4月1日，艺名表记改为汉字的“园崎未惠”。\r\n2008年11月8日，宣布结婚。\r\n2013年12月30日，经过4年半的婚姻生活后离婚。","career":["artist","seiyu"],"id":3943,"type":1,"locked":false}],"type":1,"id":217132},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/27/e6/217855_crt_hayIA.jpg","grid":"https://lain.bgm.tv/pic/crt/g/27/e6/217855_crt_hayIA.jpg","large":"https://lain.bgm.tv/pic/crt/l/27/e6/217855_crt_hayIA.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/27/e6/217855_crt_hayIA.jpg"},"name":"アレックス","summary":"スプリーキラー所属","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/ee/d9/8253_prsn_5s7m7.jpg?r=1775328732","grid":"https://lain.bgm.tv/pic/crt/g/ee/d9/8253_prsn_5s7m7.jpg?r=1775328732","large":"https://lain.bgm.tv/pic/crt/l/ee/d9/8253_prsn_5s7m7.jpg?r=1775328732","medium":"https://lain.bgm.tv/r/400/pic/crt/l/ee/d9/8253_prsn_5s7m7.jpg?r=1775328732"},"name":"村瀬歩","short_summary":"日本の男性声優。アメリカ合衆国出身。ヴィムス所属。\r\n\r\nアメリカで生まれた後、高校時代まで愛知県で過ごし、京都府の大学に進学後上京。\r\n芝居を観るのが好きだったことから声優を目指し、日本ナレーション演技研究所へ入所。2012年、『Persona4 the ANIMATION』で声優デビュー。同年、『新世界より』の青沼瞬（14歳）役で初のメインキャラクターを演じた。2014年、『ハイキュー!!』の日向翔陽役で初主演を果たした。\r\n2016年に、第10回声優アワードで新人男優賞を受賞した。\r\n\r\n尊敬する声優は、自身が声優を目指すきっかけとなった大友龍三郎や、年齢が近く共演も多い松岡禎丞。\r\n中性的な音質を生かした役を演じることが多く、女性のガヤに加わったり、『チア男子!!』では佐久間龍造役と姉3名の役も兼ねるなど、女性キャラクターを演じることもある。またラジオなどでも村瀬歩（あゆみ）という女子の設定で話すことがある。一方で、『M3〜ソノ黒キ鋼〜』の伊削ヘイト役のように狂気じみた低音ボイスもこなせるほど声域が非常に広い。\r\n帰国子女のため英会話が堪能で、英語を必要とするモブキャラやガヤもこなし、洋画の吹き替えも増えている。","career":["seiyu"],"id":8253,"type":1,"locked":false}],"type":1,"id":217855},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/4e/e4/217856_crt_Cn744.jpg","grid":"https://lain.bgm.tv/pic/crt/g/4e/e4/217856_crt_Cn744.jpg","large":"https://lain.bgm.tv/pic/crt/l/4e/e4/217856_crt_Cn744.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/4e/e4/217856_crt_Cn744.jpg"},"name":"クライド","summary":"スプリーキラー所属","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/1d/3b/4786_seiyu_anidb.jpg?r=1495990760","grid":"https://lain.bgm.tv/pic/crt/g/1d/3b/4786_seiyu_anidb.jpg?r=1495990760","large":"https://lain.bgm.tv/pic/crt/l/1d/3b/4786_seiyu_anidb.jpg?r=1495990760","medium":"https://lain.bgm.tv/r/400/pic/crt/l/1d/3b/4786_seiyu_anidb.jpg?r=1495990760"},"name":"利根健太朗","short_summary":"利根 健太朗（とね けんたろう、1982年5月29日 - ）は、日本の男性声優。アイムエンタープライズ所属。広島県出身。血液型はA型。東京外国語大学卒業。愛称はトネケン、もじゃ。スリーサイズはB95 W93 H97。\r\n\r\n1982年5月29日、広島県生まれ。小学校3年生から5年生まで、父親の仕事の関係でアメリカに住んでいた。日本に帰国後、中学校と高校では放送部に所属。\r\n東京外国語大学に進学し、タガログ語を専攻。東京外国語大学では放送部がなかったため、演劇サークルに入る。その後、大学2年生のときに日本ナレーション演技研究所に通い始め、入所4年目（研修科2年目）でアイムエンタープライズへの所属が決まる。なお、大学の方は7年かけて卒業している。\r\n2006年、茨城県近代美術館の『真夜中の美術館』展示用コンテンツの仕事でデビュー。\r\n\r\nアフロヘアーと間違えられるほどの天然パーマがトレードマークで、愛称の1つ「もじゃ」もこの髪型に由来する。\r\n小学生のときにアメリカに住んでいたこともあり、英会話が得意。英検準1級の資格を持つ。\r\n音響機器が好きで、趣味に「効果音作り」、特技に「舞台音響」を挙げている。\r\n自身の性格については「根に人を楽しませたい、喜んでもらいたいという気持ちがある」と発言している。\r\n俳優の鈴木亮平とは大学の同期で、在学中は同じ演劇サークルに所属していた。また、藤田咲・丹沢晃之・成家義哉・中村公子・大西望は日本ナレーション演技研究所の研修科時代の同期。\r\nアイムエンタープライズの同期に日笠陽子・折戸マリ・早見沙織がいる。","career":["seiyu"],"id":4786,"type":1,"locked":false}],"type":1,"id":217856},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/0d/64/218254_crt_FhXHF.jpg","grid":"https://lain.bgm.tv/pic/crt/g/0d/64/218254_crt_FhXHF.jpg","large":"https://lain.bgm.tv/pic/crt/l/0d/64/218254_crt_FhXHF.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/0d/64/218254_crt_FhXHF.jpg"},"name":"南最愛","summary":"南新汰的妹妹","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/b7/b5/27824_prsn_H12DG.jpg","grid":"https://lain.bgm.tv/pic/crt/g/b7/b5/27824_prsn_H12DG.jpg","large":"https://lain.bgm.tv/pic/crt/l/b7/b5/27824_prsn_H12DG.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/b7/b5/27824_prsn_H12DG.jpg"},"name":"花井美春","short_summary":"IAM エージェンシー所属\r\n\r\n出身地:北海道\r\n資　格:公認民謡 唄5段、三味線4段\r\n特　技:民謡、三味線\r\n趣　味:プロレス観戦","career":["seiyu"],"id":27824,"type":1,"locked":false}],"type":1,"id":218254},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/8b/8d/218255_crt_Z4C1u.jpg","grid":"https://lain.bgm.tv/pic/crt/g/8b/8d/218255_crt_Z4C1u.jpg","large":"https://lain.bgm.tv/pic/crt/l/8b/8d/218255_crt_Z4C1u.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/8b/8d/218255_crt_Z4C1u.jpg"},"name":"岡田","summary":"河野来梦的初中同学、单恋对象。","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/81/c0/7385_prsn_3DfT0.jpg?r=1543641007","grid":"https://lain.bgm.tv/pic/crt/g/81/c0/7385_prsn_3DfT0.jpg?r=1543641007","large":"https://lain.bgm.tv/pic/crt/l/81/c0/7385_prsn_3DfT0.jpg?r=1543641007","medium":"https://lain.bgm.tv/r/400/pic/crt/l/81/c0/7385_prsn_3DfT0.jpg?r=1543641007"},"name":"逢坂良太","short_summary":"日本男性声优，隶属日本EARLY WING公司。德岛县出身。\r\n\r\n原本只是很喜欢动画，并没有以成为声优为目标，但是在高中的入学式突然觉得“要成为声优”为目标。在家乡的工业高中毕业后，就和一起想要成为声优的朋友一起来到东京，在日本工学院八王子专门学校的舞台科花了两年学习舞台的基础，最后在专门学校毕业后就到了事务所参加考试，但是不幸落选了，在之后，参加了EARLY WING的追加面试中得到了正选。\r\n在2012年4月中，《钓球》的真田雪是成为声优后的第一次主役。\r\n在2015年的第9回声优奖获得新人男优赏。\r\n\r\n兴趣是散步和电玩，假日会花数个小时散步。\r\n喜欢的歌手是JAM Project。\r\n有一个姐姐和一个弟弟。\r\n喜欢玩Tales of Eternia，甚至列入喜欢的游戏前三名。","career":["seiyu"],"id":7385,"type":1,"locked":false}],"type":1,"id":218255},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/e1/e7/219736_crt_4U45K.jpg","grid":"https://lain.bgm.tv/pic/crt/g/e1/e7/219736_crt_4U45K.jpg","large":"https://lain.bgm.tv/pic/crt/l/e1/e7/219736_crt_4U45K.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/e1/e7/219736_crt_4U45K.jpg"},"name":"花火師の親方","summary":"","relation":"闲角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/45/a5/21350_prsn_c7tY6.jpg","grid":"https://lain.bgm.tv/pic/crt/g/45/a5/21350_prsn_c7tY6.jpg","large":"https://lain.bgm.tv/pic/crt/l/45/a5/21350_prsn_c7tY6.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/45/a5/21350_prsn_c7tY6.jpg"},"name":"中務貴幸","short_summary":"日本の声優。身長173cm。神奈川県出身。B-Box所属。\r\n趣味：テニス、読書、ラグビー、水泳