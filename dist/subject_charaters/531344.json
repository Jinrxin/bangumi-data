:[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/df/ce/12569_prsn_EVTkz.jpg?r=1687679505","grid":"https://lain.bgm.tv/pic/crt/g/df/ce/12569_prsn_EVTkz.jpg?r=1687679505","large":"https://lain.bgm.tv/pic/crt/l/df/ce/12569_prsn_EVTkz.jpg?r=1687679505","medium":"https://lain.bgm.tv/r/400/pic/crt/l/df/ce/12569_prsn_EVTkz.jpg?r=1687679505"},"name":"山村響","short_summary":"福岡県出身。血液型はO型。声優・キャラクターソング等の名義は山村響、アーティストとしてはhibiku（ひびく）名義で音楽活動をしていたが、2019年3月発売のミニアルバムからは音楽活動も山村響名義に統一する。","career":["artist","seiyu"],"id":12569,"type":1,"locked":false}],"type":1,"id":182645},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/2c/fd/184111_crt_F2931.jpg","grid":"https://lain.bgm.tv/pic/crt/g/2c/fd/184111_crt_F2931.jpg","large":"https://lain.bgm.tv/pic/crt/l/2c/fd/184111_crt_F2931.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/2c/fd/184111_crt_F2931.jpg"},"name":"草野海","summary":"草野雫の兄。","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/11/42/36453_prsn_UAPpP.jpg","grid":"https://lain.bgm.tv/pic/crt/g/11/42/36453_prsn_UAPpP.jpg","large":"https://lain.bgm.tv/pic/crt/l/11/42/36453_prsn_UAPpP.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/11/42/36453_prsn_UAPpP.jpg"},"name":"小笠原仁","short_summary":"小笠原 仁（おがさわら じん、1994年8月16日 - ）は、日本の男性声優、歌手。神奈川県出身。EARLY WING準所属。","career":["artist","seiyu"],"id":36453,"type":1,"locked":false}],"type":1,"id":184111},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/4e/c8/186671_crt_i0kJ3.jpg","grid":"https://lain.bgm.tv/pic/crt/g/4e/c8/186671_crt_i0kJ3.jpg","large":"https://lain.bgm.tv/pic/crt/l/4e/c8/186671_crt_i0kJ3.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/4e/c8/186671_crt_i0kJ3.jpg"},"name":"星崎結衣","summary":"自転車ソロキャンパー。\r\n厳に興味を持っている。","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/e5/a0/20701_prsn_3sfX0.jpg?r=1562761023","grid":"https://lain.bgm.tv/pic/crt/g/e5/a0/20701_prsn_3sfX0.jpg?r=1562761023","large":"https://lain.bgm.tv/pic/crt/l/e5/a0/20701_prsn_3sfX0.jpg?r=1562761023","medium":"https://lain.bgm.tv/r/400/pic/crt/l/e5/a0/20701_prsn_3sfX0.jpg?r=1562761023"},"name":"富田美憂","short_summary":"富田美忧（日文名：富田 美憂，纯假名：とみた みゆ，罗马字：Tomita Miyu），1999年11月15日出生于埼玉县，日本女性声优、歌手，现所属Amuse Creative Studio（原属Amuse），A型血。声优组合Kleissis、Study成员，2019年起以日本哥伦比亚旗下歌手身份SOLO活动，官方粉丝俱乐部为“＋ you”。代表角色包括《偶像活动Stars！》的虹野梦、《珈百璃的堕落》的珈百璃、《来自深渊》的莉可、《雏子的笔记》的夏川玖井菜、《隔壁的吸血鬼美眉》的苏菲·托莱特、《偶像大师 灰姑娘女孩》的砂冢明、《我们真的学不来》的绪方理珠、《异种族风俗娘评鉴指南》的可利姆维儿、《辉夜大小姐想让我告白～天才们的恋爱头脑战～》的伊井野弥子、《战斗员派遣中！》的如月爱丽丝、《碧蓝航线》的新泽西等。\r\n\r\n1999年，11月15日出生于埼玉县。\r\n出道前，小学时因《吸血鬼骑士》对声优行业产生兴趣，并憧憬剧中宫野真守的演出；初中二年级加入放送委员，因在卡拉OK被朋友一句“歌也唱得好、声音又可爱，不如当声优吧”点醒，开始把自己的声音视作个性；由于家中经济并不宽裕，她报考了合格者可免费受训一年的“声优艺人养成Program Selection”并顺利通过。\r\n2014年，在第一回“Ani☆tan!”中进入决赛、被6家公司看中；同期举办的“2014声优艺人养成Program Selection”中获得最高奖。\r\n2015年，在《干物妹！小埋》中出演幼年时期的土间大平，声优出道。\r\n2016年，在《偶像活动Stars！》中饰演虹野梦，首次担任主角。\r\n2018年，被选为游戏《ARCA LAST 终焉世界与歌姬的果实》衍生声优组合Kleissis的成员，饰演林堂アキラ。\r\n2019年，因出演《我们无法一起学习》，与白石晴香、铃代纱弓组成声优组合Study开始活动；11月13日加入日本哥伦比亚，以歌手身份SOLO出道。\r\n2022年，3月14日，广播节目《富田美忧·前田佳织里的“调查委托，恭候光临！”》获得第7回Aniradio Award“BEST BENEFIT RADIO 为之受益广播奖”。\r\n2023年，1月3日事务所公告其新型冠状病毒PCR检测呈阳性。\r\n2024年，10月1日因Amuse公司分割，移籍至新设立的全资子公司Amuse Creative Studio。\r\n2025年，9月《永久的黄昏》、10月《赛马娘 芦毛灰姑娘》第二季等参演动画相继播出；同年出演《终末摩托游》《最后可以再拜托您一件事吗？》《双人独自露营》等作品，并以砂冢明的名义登上《偶像大师 M@STERS OF IDOL WORLD 2025》的舞台。\r\n2026年，1月《公主大人，接下来是“拷问”时间》第二季开播；4月《上伊那牡丹，醉姿如百合》开播；7月《剧场版偶像活动Stars！-Anniversary Stars-》上映并出席公开纪念舞台问候；8月赴美出席Anime NYC 2026《超超超超超喜欢你的100个女朋友》粉丝见面活动，同月30日举办官方粉丝俱乐部“＋ you”成立5周年纪念活动；10月《大叔喜欢可爱小玩意》开播，饰演帕格太郎；11月底出席《偶像活动Stars！》10周年纪念活动；同年另有《异世界悠闲农家》第二季、《自称恶役大小姐的婚约者观察记录。》《我回来了，他又来打扰了！》及剧场版《来自深渊》等作品问世。\r\n\r\n她的声优梦始于小学时对《吸血鬼骑士》的沉迷，憧憬的宫野真守至今仍是目标——她的梦想就是“和宫野一起唱歌”；当时正是水树奈奈等人频繁登上电视、看起来闪闪发亮的时期。\r\n\r\n她自称从小就是家里蹲的阿宅，动漫画与游戏的兴趣受大自己6岁的宅表哥影响。比起少女漫画更喜欢战斗题材的作品，曾经有段时间沉迷于《BLOOD+》——还曾因漫画中毒患上严重的“妄想症”，幻想用魔法让自己变成透明人。她入行后以《珈百璃的堕落》的珈百璃为代表配音了大量宅女角色，在家练习珈百璃声线时被妈妈吐槽“这不就是你吗”。\r\n\r\n截至2017年配音珈百璃时还在上高中，在录音现场经常被工作人员问起学校的事。\r\n\r\n她多才多艺：空手道练了6年、拥有黑带资格，最擅长上段回旋踢；爱好画插画，高中时还是漫画研究部成员，喜欢的科目是英语和美术。\r\n\r\n作为资深乙女游戏宅，《歌之王子殿下》《薄樱鬼》等作品信手拈来，也正是玩了《歌之王子殿下》才沉迷上唱歌；喜欢唱歌、跳舞和迪士尼，最爱的食物是苹果、栗子和蛋包饭，讨厌烤鱼到只吃生鱼片的程度。她还热衷收集鞋子，可惜脚长只有21.5cm，能挑的款式十分有限；想挑战的方向则是抖S与反派角色。\r\n\r\n动物方面她几乎来者不拒——狼、犬、白虎，除昆虫外全都喜欢，家里养着爱犬“恰普”，2021年又添了豆柴“こはく”，每天早上七点准时叫她起床。\r\n\r\n在《异种族风俗娘评鉴指南》广播里被曝有两个弟弟。\r\n\r\n若被问“用一句话形容自己”，她的答案是“行为可疑”；而她最喜欢的格言是“思考不如挑战！”。\r\n\r\n每次出演有原作的作品，她都会先把原作读透、理解角色的思考与行动方式再去参加试音。","career":["artist","seiyu"],"id":20701,"type":1,"locked":false}],"type":1,"id":186671}],"detail":[{"birth_mon":null,"gender":null,"birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/01/01/10956_crt_122YQ.jpg","grid":"https://lain.bgm.tv/pic/crt/g/01/01/10956_crt_122YQ.jpg","large":"https://lain.bgm.tv/pic/crt/l/01/01/10956_crt_122YQ.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/01/01/10956_crt_122YQ.jpg"},"summary":"戏剧角色背着台上其他剧中人对观众说的话。也指影视片中的解说词。说话者不出现在画面上，但直接以语言来介绍影片内容、交待剧情或发表议论，包括对白的使用。","name":"ナレーション","infobox":[{"key":"简体中文名","value":"旁白"},{"key":"别名","value":[{"v":"ナレーター"},{"k":"第二中文名","v":"解説"},{"k":"英文名","v":"Narration / Narrator"},{"k":"日文名","v":"語り"},{"k":"罗马字","v":"Nareeshon"},{"k":"昵称","v":"天之声"},{"k":"拼音","v":"páng bái"}]}],"stat":{"comments":72,"collects":217},"id":10956,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":"female","birth_day":null,"birth_year":null,"blood_type":null,"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/1c/a9/173740_crt_WGowy.jpg?r=1743948441","grid":"https://lain.bgm.tv/pic/crt/g/1c/a9/173740_crt_WGowy.jpg?r=1743948441","large":"https://lain.bgm.tv/pic/crt/l/1c/a9/173740_crt_WGowy.jpg?r=1743948441","medium":"https://lain.bgm.tv/r/400/pic/crt/l/1c/a9/173740_crt_WGowy.jpg?r=1743948441"},"summary":"雫の友人。\r\n雫が年上の男性とキャンプに行っていることを心配しているが、楽しんで協力している節もある。","name":"火野瑞希","infobox":[{"key":"简体中文名","value":"火野瑞希"},{"key":"别名","value":[]},{"key":"性别","value":"女"}],"stat":{"comments":0,"collects":2},"id":173740,"locked":false,"type":1,"nsfw":false},{"birth_mon":null,"gender":"female","birth_day":null,"birth_year":null,"blood_type":null,"im