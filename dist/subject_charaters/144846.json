anidb.jpg","large":"https://lain.bgm.tv/pic/crt/l/91/c7/5033_seiyu_anidb.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/91/c7/5033_seiyu_anidb.jpg"},"name":"渡辺菜生子","short_summary":"","career":["seiyu"],"id":5033,"type":1,"locked":false}],"type":1,"id":164754},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/3f/39/164755_crt_WG13Z.jpg","grid":"https://lain.bgm.tv/r/200/pic/crt/l/3f/39/164755_crt_WG13Z.jpg","large":"https://lain.bgm.tv/pic/crt/l/3f/39/164755_crt_WG13Z.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/3f/39/164755_crt_WG13Z.jpg"},"name":"ダブルダウン","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/07/f7/4540_prsn_46oIK.jpg?r=1692334567","grid":"https://lain.bgm.tv/r/200/pic/crt/l/07/f7/4540_prsn_46oIK.jpg?r=1692334567","large":"https://lain.bgm.tv/pic/crt/l/07/f7/4540_prsn_46oIK.jpg?r=1692334567","medium":"https://lain.bgm.tv/r/400/pic/crt/l/07/f7/4540_prsn_46oIK.jpg?r=1692334567"},"name":"竹中直人","short_summary":"竹中 直人（たけなか なおと、1956年3月20日 - ）は、日本の俳優、声優、映画監督、タレント、コメディアン、歌手。","career":["producer","artist","seiyu","actor"],"id":4540,"type":1,"locked":false}],"type":1,"id":164755},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/2d/25/164756_crt_UZhfn.jpg","grid":"https://lain.bgm.tv/r/200/pic/crt/l/2d/25/164756_crt_UZhfn.jpg","large":"https://lain.bgm.tv/pic/crt/l/2d/25/164756_crt_UZhfn.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/2d/25/164756_crt_UZhfn.jpg"},"name":"ビット","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/72/1d/34291_prsn_9cUrk.jpg?r=1700319520","grid":"https://lain.bgm.tv/r/200/pic/crt/l/72/1d/34291_prsn_9cUrk.jpg?r=1700319520","large":"https://lain.bgm.tv/pic/crt/l/72/1d/34291_prsn_9cUrk.jpg?r=1700319520","medium":"https://lain.bgm.tv/r/400/pic/crt/l/72/1d/34291_prsn_9cUrk.jpg?r=1700319520"},"name":"三吉彩花","short_summary":"　　日本の女優、女性ファッションモデル。埼玉県出身。アミューズ所属。女性アイドルグループ・さくら学院の元メンバー。\r\n　　Sugar&Spice に所属。小学1年生で読者モデルにとなり、小学3年生の時に原宿でスカウトされて現在の事務所アミューズに所属。\r\n　　『ニコ☆プチ』の事務所オーディションに合格し、『nicola』2008年7月号の別冊「2008年ニコ☆プチ夏号」に初登場する。\r\n　　2010年6月号の『ニコ☆プチ』をもって、専属モデル（プチモ）を卒業。\r\n　　2010年4月にアミューズのキッズ事業室から「開校」したアイドルグループ『さくら学院』の初期メンバーとして活動開始。\r\n　　2010年8月18日、ミスセブンティーン2010に合格し、Seventeenの専属モデルとなる。\r\n　　2012年3月25日、義務教育終了に伴い、『さくら学院』を卒業。映画『グッモーエビアン!』の演技が評価され、第67回毎日映画コンクールおよび第35回ヨコハマ映画祭で新人賞を受賞。\r\n　　2017年6月30日、11月号をもってSeventeen専属モデルを卒業することを発表。8月24日、パシフィコ横浜・国立大ホールで開催された「Seventeen 夏の学園祭2017」において卒業式が行われた。\r\n　　2018年4月16日発売の『週刊プレイボーイ』18号にて、初めて男性誌の表紙・巻頭グラビアを飾った。","career":["actor"],"id":34291,"type":1,"locked":false}],"type":1,"id":164756},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/e4/2d/164757_crt_J65FF.jpg","grid":"https://lain.bgm.tv/r/200/pic/crt/l/e4/2d/164757_crt_J65FF.jpg","large":"https://lain.bgm.tv/pic/crt/l/e4/2d/164757_crt_J65FF.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/e4/2d/164757_crt_J65FF.jpg"},"name":"レプレ","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/58/2d/19332_prsn_9e9N9.jpg?r=1502509940","grid":"https://lain.bgm.tv/r/200/pic/crt/l/58/2d/19332_prsn_9e9N9.jpg?r=1502509940","large":"https://lain.bgm.tv/pic/crt/l/58/2d/19332_prsn_9e9N9.jpg?r=1502509940","medium":"https://lain.bgm.tv/r/400/pic/crt/l/58/2d/19332_prsn_9e9N9.jpg?r=1502509940"},"name":"武田玲奈","short_summary":"武田 玲奈（たけだ れな、1997年07月27日 - ）は、日本のタレント、ファッションモデル、グラビアアイドル、女優。本名、同じ。\r\n福島県いわき市出身。ヴィズミック所属。","career":["actor"],"id":19332,"type":1,"locked":false}],"type":1,"id":164757},{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/ef/39/164758_crt_Cdjno.jpg","grid":"https://lain.bgm.tv/r/200/pic/crt/l/ef/39/164758_crt_Cdjno.jpg","large":"https://lain.bgm.tv/pic/crt/l/ef/39/164758_crt_Cdjno.jpg","medium":"https://lain.bgm.tv/r/400/pic/crt/l/ef/39/164758_crt_Cdjno.jpg"},"name":"アルバ","relation":"配角","actors":[{"images":{"small":"https://lain.bgm.tv/r/100/pic/crt/l/2a/2c/32427_prsn_pql2L.jpg?r=1551069970","grid":"https://lain.bgm.tv/r/200/pic/crt/l/2a/2c/32427_prsn_pql2L.jpg?r=1551069970","large":"https://lain.bgm.tv/pi